{
  "name": "justsend-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "prepare": "husky install",
    "format-and-stage": "prettier --write . && git add .",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:appium": "wdio wdio.conf.js",
    "wdio": "wdio run ./wdio.conf.js",
    "test:appium:login": "wdio run ./wdio.conf.js --spec ./test/specs/login.e2e.js",
    "test:appium:report": "wdio run ./wdio.conf.js && npx allure generate allure-results --clean && npx allure open",
    "test:appium:debug": "wdio run ./wdio.conf.js --spec ./test/specs/login.e2e.js --logLevel debug",
    "test:appium:deposit": "wdio run ./wdio.conf.js --spec ./test/specs/deposit.e2e.js",
    "test:appium:send": "wdio run ./wdio.conf.js --spec ./test/specs/send.e2e.js",
    "test:appium:withdraw": "wdio run ./wdio.conf.js --spec ./test/specs/withdraw.e2e.js",
    "test:appium:receive": "wdio run ./wdio.conf.js --spec ./test/specs/receive.e2e.js",
    "test:appium:all": "wdio run ./wdio.conf.js",
    "appium:inspector": "appium-inspector",
    "inspector": "node scripts/start-inspector.js",
    "allure:generate": "npx allure generate allure-results --clean",
    "allure:open": "npx allure open",
    "allure:serve": "npx allure serve allure-results"
  },
  "dependencies": {
    "@expo/metro-config": "^0.20.14",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "appium-doctor": "^1.16.2",
    "axios": "^1.9.0",
    "expo": "~53.0.8",
    "expo-blur": "~14.1.4",
    "expo-constants": "~17.1.6",
    "expo-dev-client": "~5.2.1",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.1.7",
    "expo-linear-gradient": "~14.1.4",
    "expo-linking": "~7.1.4",
    "expo-router": "~5.0.6",
    "expo-secure-store": "^14.2.3",
    "expo-splash-screen": "~0.30.8",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.4",
    "expo-system-ui": "~5.0.7",
    "expo-web-browser": "~14.1.6",
    "firebase": "^11.8.1",
    "js-cookie": "^3.0.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "react-native-chart-kit": "^6.12.0",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-paper": "4.9.2",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-svg": "15.8.0",
    "react-native-toast-message": "^2.3.0",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/cypress": "^10.0.3",
    "@types/chai": "^5.2.2",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.17",
    "@types/react": "~19.0.10",
    "@wdio/allure-reporter": "^9.15.0",
    "@wdio/appium-service": "^9.15.0",
    "@wdio/cli": "^8.44.1",
    "@wdio/globals": "^9.15.0",
    "@wdio/local-runner": "^9.15.0",
    "@wdio/mocha-framework": "^9.15.0",
    "@wdio/spec-reporter": "^9.15.0",
    "@wdio/visual-service": "^8.0.4",
    "allure-commandline": "^2.34.0",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.3",
    "appium-wait-plugin": "^3.0.2",
    "appium-xcuitest-driver": "^5.6.0",
    "autoprefixer": "^10.4.21",
    "chai": "^5.2.0",
    "cypress": "^14.4.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3"
  },
  "private": true,
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "semi": true
  }
}
